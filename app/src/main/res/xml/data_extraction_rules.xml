<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: nothing goes to Google's cloud backup (stickers stay local; use the app's backup file instead).
     A direct phone-to-phone transfer when setting up a new phone still copies the packs. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
</data-extraction-rules>
